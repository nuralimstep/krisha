TELEGRAM_BOT_TOKEN=
# Необязательный ID старого владельца для переноса подписки. Новым пользователям достаточно /start.
TELEGRAM_CHAT_ID=
ADMIN_TOKEN=replace-with-long-random-secret
POLL_INTERVAL_SECONDS=60
SEARCH_PAGES=3
# Проверять доступность ранее найденных квартир не чаще раза в 5 минут, до 20 за цикл.
AVAILABILITY_INTERVAL_SECONDS=300
AVAILABILITY_BATCH_SIZE=20
MIN_PRICE=100000
MAX_PRICE=150000
# «Хорошая»: от 20 м², с фото, без явного подселения/временной аренды.
MIN_AREA=20
REQUIRE_PHOTO=true
OWNERS_ONLY=false
DATABASE_PATH=data/krisha.sqlite3
